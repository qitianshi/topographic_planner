# number of grid cells in the x-direction (pathfinder, animate)
NPOINTS_X=432

# number of grid cells in the x-direction (pathfinder, animate)
NPOINTS_Y=296

# the starting point (pathfinder.sh)
START='(15.4, 20.3)'

# the destination point (pathfinder.sh)
DEST='(37.4, 4.1)'

# the reslution of grid cells in the processed map (pathfinder)
RESOLUTION=0.1

# the filepath to the processed map data csv file (pathfinder, animate)
MAPDATA=data/mapdata2.csv

# the filepath to the path data csv file output by `pathfinder` (pathfinder)
PATHOUT=data/path.csv

# the number of smoothing steps to be used by the smoother (pathfinder, animate)
# you may change this between calls to the animator, (without generating a new animate file)
# set this to zero if you dont want any smoothing
SMOOTH_STEPS=10

# weights used by `pathfinder` (pathfinder)
PF_WEIGHT_GRAD=1.26f
PF_WEIGHT_XY_DIST=1.34f
PF_WEIGHT_COST=0.00706f
PF_WEIGHT_HEURISTIC=3.5f

# maximum gradient to be allowed by the `pathfinder` (pathfinder)
# tan(30) is 0.577
PF_MAX_GRADIENT=0.577f

# the filepath for print path evaluation metrics. (pathfinder)
# use "NULL" or 'null' if you dont want this output
# use stdout if you want it to be printed to standard output
PF_EVAL_PATH=NULL

# the filepath for print the final state of the A* search tree in ascii (pathfinder)
# use "NULL" or 'null' if you dont want this output
# use stdout if you want it to be printed to standard output
PF_DISPLAY_SEARCH=NULL

# the filepath where `pathfinder` will output the animation data file, needed
# by the animator (pathfinder, animate)
# the variables (MAPDATA, RESOLUTION, NPOINTS_X, NPOINTS_Y) used to invoke
#   `animate` must be the same as those used to generate the animation data file
#   otherwise expect `animate` to crash
# if you do not wish for the `pathfinder` to generate this file, unset this
#   environment variable declaration
PF_VISUALIZE_SEARCH=data/animate.dat

# the speed of the animator (animate)
# you may change this between invocations of `animate` to vary the speed.
# it determines the number of lines to be drawn "secretly" before it is
#   displayed on the screen
VIS_STEP_SIZE=1000
